# Copy to `.env` and adjust as needed. Every key is optional; sane defaults ship in code.

# --- HTTP server ---
WEBSEARCH_HOST=0.0.0.0
WEBSEARCH_PORT=8000

# --- Logging ---
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL
WEBSEARCH_LOG_LEVEL=INFO
# "json" for structured one-line-per-record output, "text" for human-readable
WEBSEARCH_LOG_FORMAT=text

# --- Browser ---
# Set to "false" to watch a real browser window while debugging selectors
WEBSEARCH_BROWSER_HEADLESS=true
# Per-request navigation timeout in milliseconds
WEBSEARCH_REQUEST_TIMEOUT_MS=20000
# Optional override for the User-Agent string used by the browser
# WEBSEARCH_USER_AGENT="Mozilla/5.0 ..."

# --- Search defaults ---
WEBSEARCH_DEFAULT_MAX_RESULTS=10
WEBSEARCH_MAX_RESULTS_HARD_CAP=50

# --- API surface ---
# Comma-separated list of origins allowed by CORS. Use "*" to allow any.
WEBSEARCH_CORS_ORIGINS=*
