# Copy to `.env` and adjust as needed. Every key is optional; sane defaults ship in code.

# --- HTTP server ---
WEBSEARCH_HOST=0.0.0.0
WEBSEARCH_PORT=8000

# --- Logging ---
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL
WEBSEARCH_LOG_LEVEL=INFO
# "json" for structured one-line-per-record output, "text" for human-readable
WEBSEARCH_LOG_FORMAT=text

# --- Browser ---
# Set to "false" to watch a real browser window while debugging selectors
WEBSEARCH_BROWSER_HEADLESS=true
# Per-request navigation timeout in milliseconds
WEBSEARCH_REQUEST_TIMEOUT_MS=20000
# Optional override for the User-Agent string used by the browser
# WEBSEARCH_USER_AGENT="Mozilla/5.0 ..."

# --- Search defaults ---
WEBSEARCH_DEFAULT_MAX_RESULTS=10
WEBSEARCH_MAX_RESULTS_HARD_CAP=50

# --- Brave anti-bot / retry ---
# Total attempts (including the first) before surfacing a 429 / bot-gate.
WEBSEARCH_BRAVE_RETRY_ATTEMPTS=4
# Exponential backoff window between retries (ms). 0-30% jitter is added.
# A real Brave 429 needs *tens of seconds* to clear -- keep these generous.
WEBSEARCH_BRAVE_RETRY_BACKOFF_BASE_MS=10000
WEBSEARCH_BRAVE_RETRY_BACKOFF_MAX_MS=60000
# Random pre-navigation pause to avoid synchronized request bursts.
# Set both to 0 to disable jitter entirely.
WEBSEARCH_BRAVE_PRENAV_JITTER_MIN_MS=400
WEBSEARCH_BRAVE_PRENAV_JITTER_MAX_MS=1800
# When true, queries are submitted through the real search form on the
# homepage (the most human-looking flow). Set false to navigate straight to
# /search?q=... -- faster but trips bot heuristics more often.
WEBSEARCH_BRAVE_USE_HOMEPAGE_FLOW=true
# Per-keystroke typing delay range (ms) for the homepage flow.
WEBSEARCH_BRAVE_KEYSTROKE_MIN_MS=60
WEBSEARCH_BRAVE_KEYSTROKE_MAX_MS=180
# Optional outbound proxy used only by the Brave provider. The single most
# effective fix when your origin IP is flagged. Examples:
#   http://host:port
#   http://user:pass@host:port
#   socks5://host:port
# WEBSEARCH_BRAVE_PROXY=http://user:pass@proxy.example.com:8080

# --- API surface ---
# Comma-separated list of origins allowed by CORS. Use "*" to allow any.
WEBSEARCH_CORS_ORIGINS=*
